# =============================================================================
# CoteBook configuration
# Copy to `.env` and adjust. Every setting can also be passed as a regular
# environment variable. Nothing here has a built-in secret default.
# =============================================================================

# ---- Public address ---------------------------------------------------------
# The URL people use to reach this instance. Used for cookie security and to
# accept requests from the web client.
APP_URL=http://localhost:3000

# Port published on the host by docker compose.
PUBLISH_PORT=3000

# Set to true when running behind a reverse proxy (nginx, Caddy, Traefik, ...)
# so that client IPs and HTTPS are detected correctly.
TRUST_PROXY=false

# Extra origins (comma separated) allowed to call the API with credentials,
# e.g. a separately hosted web client. Usually empty.
CORS_ORIGINS=

# ---- Database (PostgreSQL) --------------------------------------------------
# Used by docker compose to create the bundled database.
POSTGRES_USER=cotebook
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=cotebook

# Connection string for running the server outside docker compose (local
# development, or an external database). Ignored by docker compose.
DATABASE_URL=postgres://cotebook:change-me-to-a-long-random-password@localhost:5432/cotebook

# Apply pending database migrations automatically on startup.
RUN_MIGRATIONS=true

# ---- Accounts ---------------------------------------------------------------
# Allow new sign-ups. For a personal instance, create your account and then
# set this to false.
ALLOW_REGISTRATION=true

# How long a login stays valid without activity, in days.
SESSION_TTL_DAYS=30

# Send cookies over HTTPS only. Defaults to true when APP_URL starts with https.
# COOKIE_SECURE=true

# ---- File storage -----------------------------------------------------------
# `local` stores uploads on disk; `s3` uses any S3-compatible service
# (AWS S3, MinIO, Garage, Cloudflare R2, ...).
STORAGE_DRIVER=local

# Directory for `local` storage. Docker compose mounts a volume here.
# STORAGE_LOCAL_DIR=./data/uploads

# Settings for `s3` storage.
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# S3_BUCKET=cotebook
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# Maximum size of an uploaded image, in megabytes.
MAX_UPLOAD_SIZE_MB=10

# ---- Logging ----------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- Reserved for future releases (not used yet) ----------------------------
# Email (password reset, email verification) via standard SMTP:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
#
# Third-party sign-in. Providers without credentials stay hidden.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
